{
  // Cloudflare Workers static assets. Build first: npm run build
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harder-to-fool",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "hardertofool.org",
      "custom_domain": true
    }
  ]
}
